{
  "name": "dsh-plugin-publisher",
  "version": "0.2.1",
  "type": "module",
  "description": "Skill plugin and settings page that publish a DSH plugin to npm and update a curated plugin market index.",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "publisher", "release", "npm", "market-index"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
